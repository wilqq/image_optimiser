# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# App Configuration
NEXT_PUBLIC_APP_NAME=Image Optimiser
NEXT_PUBLIC_APP_URL=http://localhost:3000

# API Configuration
# NEXT_PUBLIC_ prefix makes variables available in the browser
NEXT_PUBLIC_API_URL=/api
NEXT_PUBLIC_MAX_FILE_SIZE=10485760
NEXT_PUBLIC_MAX_FILES=10

# Server-side only variables (no NEXT_PUBLIC_ prefix)
# API Keys and Secrets
API_SECRET=your-api-secret-here
ENCRYPTION_KEY=your-encryption-key-here

# Image Processing Configuration
MAX_IMAGE_WIDTH=4096
MAX_IMAGE_HEIGHT=4096
DEFAULT_QUALITY=80

# Storage Configuration (if using external storage)
# STORAGE_PROVIDER=local
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# AWS_S3_BUCKET=

# Database Configuration (if needed in future)
# DATABASE_URL=
# DATABASE_NAME=

# Third-party Services
# ANALYTICS_ID=
# SENTRY_DSN=

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_BATCH_PROCESSING=true

# Development
NODE_ENV=development
